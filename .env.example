# Copiar a .dev.vars para desarrollo local. En Cloudflare se cargan como variables/secretos del Worker.
MP_ACCESS_TOKEN=APP_USR-...     # servidor, secreto (Credenciales → Prueba)
MP_PUBLIC_KEY=APP_USR-...       # la ve el navegador
MP_WEBHOOK_SECRET=...           # Webhooks → Clave secreta
APP_URL=https://bocetoo-app.bnvds-nico.workers.dev
ADMIN_KEY=...                   # clave larga para crear los planes desde /admin/planes.html
# Opcionales: si ya tenés los planes creados, sus IDs (si no, se guardan solos en KV)
MP_SUBSCRIPTION_PLAN_ID=
MP_SUBSCRIPTION_PLAN_ID_TODAS=
